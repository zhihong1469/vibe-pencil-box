<Project Sdk="Microsoft.NET.Sdk">

  <!-- 量产烧录 UI · Dongle 轨（量产保障/isp烧录/Dongle/01+02 号）：
       给已验证的一键烧录.bat 命令行方案套 UI 壳，烧录动作全权交给包内 isd_download.exe，
       编排层只管 进程/输出采集/PASS 证据判定/连续烧录。net48 WinForms 绿色免安装，
       零 NuGet 依赖（纯 Process 编排，不碰串口）；发布 → output\produce\R1D\。
       键盘轨（PenFlash，串口 ISP）为并行独立工程，互不依赖。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <AssemblyName>DongleFlash</AssemblyName>
    <RootNamespace>PencilBox.DongleFlash</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- record 的 IsExternalInit 编译垫片（internal 按程序集隔离，须各自带一份） -->
    <Compile Include="..\PencilBox.OtaCore\Shims.cs" Link="Shims.cs" />
  </ItemGroup>

</Project>
