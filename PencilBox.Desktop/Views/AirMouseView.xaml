<UserControl x:Class="PencilBox.Desktop.Views.AirMouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1060">
    <UserControl.Resources>
        <!-- 连接状态灯（03 §2：绿=已连接 / 灰=未连接 / 红=连接丢失） -->
        <Style x:Key="LinkLight" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="Gray"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LinkState}" Value="Connected">
                    <Setter Property="Fill" Value="#2ECC71"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LinkState}" Value="Lost">
                    <Setter Property="Fill" Value="#E74C3C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ 连接栏（03 §2） ============ -->
            <GroupBox Grid.Row="0" Header="空鼠调参工作台（0x61 内部调参 · 仅串口轨直连笔端，基站零感知）" Margin="4">
                <StackPanel Orientation="Horizontal" Margin="4">
                    <TextBlock Text="串口:" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding SerialPorts}" SelectedItem="{Binding SelectedPort}"
                              MinWidth="110" Margin="8,0"/>
                    <Button Content="刷新" Command="{Binding RefreshPortsCommand}"
                            Style="{StaticResource ActionButton}" MinWidth="56" Margin="4,0"/>
                    <Button Content="连接" Command="{Binding ConnectCommand}"
                            Style="{StaticResource ActionButton}" MinWidth="64" Margin="12,0,4,0"
                            ToolTip="打开串口后自动发 0x03 读版本并读取全表；未连接时所有参数卡置灰"/>
                    <Button Content="断开" Command="{Binding DisconnectCommand}"
                            Style="{StaticResource ActionButton}" MinWidth="56" Margin="4,0"/>
                    <Ellipse Style="{StaticResource LinkLight}" ToolTip="绿=已连接 / 灰=未连接 / 红=连接丢失"/>
                    <TextBlock Text="{Binding FirmwareText}" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="#2C3E50" MinWidth="180"/>
                    <Button Content="读取全表" Command="{Binding LoadAllCommand}" MinWidth="80" Margin="16,0,4,0"
                            Style="{StaticResource ActionButton}"
                            ToolTip="0x61/01 全表读：重连/改完想对齐时用；笔端掉电失忆是特性，UI 不缓存旧值"/>
                </StackPanel>
            </GroupBox>

            <!-- ============ 主区：左卡片+曲线，右会话面板 ============ -->
            <Grid Grid.Row="1" Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="285"/>
                </Grid.ColumnDefinitions>

                <!-- 左：6 参数卡片 + 增益曲线 -->
                <Grid Grid.Column="0" IsEnabled="{Binding IsConnected}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 参数卡片（03 §3：滑条+数值框+[−][+]+折页文案+★偏离；防抖 300ms 自动下发） -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding Cards}" Margin="0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <GroupBox Width="345" Margin="4">
                                    <GroupBox.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding HeaderText}" FontWeight="Bold"/>
                                            <TextBlock Text=" ★" Foreground="Goldenrod" FontWeight="Bold"
                                                       Visibility="{Binding ModifiedVisibility}"
                                                       ToolTip="当前值偏离出厂宏值"/>
                                            <TextBlock Text=" ⚠️进阶" Foreground="#E67E22" FontSize="11"
                                                       Visibility="{Binding AdvancedVisibility}"/>
                                        </StackPanel>
                                    </GroupBox.Header>
                                    <StackPanel Margin="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Grid.Column="0" Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                    Value="{Binding SliderValue, UpdateSourceTrigger=PropertyChanged}"
                                                    IsSnapToTickEnabled="True" TickFrequency="{Binding Step}"
                                                    SmallChange="{Binding Step}" VerticalAlignment="Center"
                                                    Margin="0,0,6,0"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="−" Command="{Binding StepDownCommand}" Width="24" Margin="0,0,2,0"
                                                        ToolTip="步进减小"/>
                                                <Button Content="+" Command="{Binding StepUpCommand}" Width="24" Margin="0,0,4,0"
                                                        ToolTip="步进增大"/>
                                                <TextBox Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="58" Padding="2,1" VerticalAlignment="Center"
                                                         ToolTip="可直接键入（超出范围会被笔端拒收并回弹旧值）"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="生效:" VerticalAlignment="Center" Foreground="Gray"/>
                                            <TextBlock Grid.Column="1" Text="{Binding EchoText}" VerticalAlignment="Center"
                                                       FontWeight="Bold" Margin="4,0,0,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Unit}" VerticalAlignment="Center"
                                                       Foreground="Gray" Margin="4,0,0,0"/>
                                            <TextBlock Grid.Column="4" Text="{Binding RangeText}" VerticalAlignment="Center"
                                                       Foreground="Gray"/>
                                        </Grid>
                                        <!-- 红条错误面（02 越界回弹 / 03 OTA / 非法输入） -->
                                        <Border Background="#FDECEA" CornerRadius="2" Padding="4,2" Margin="0,4,0,0"
                                                Visibility="{Binding ErrorVisibility}">
                                            <TextBlock Text="{Binding ErrorText}" Foreground="#C0392B" TextWrapping="Wrap"/>
                                        </Border>
                                        <Expander Header="调法说明" IsExpanded="{Binding GuideExpanded}" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding Guide}" TextWrapping="Wrap" Foreground="#34495E"
                                                       FontSize="11" Margin="8,2"/>
                                        </Expander>
                                    </StackPanel>
                                </GroupBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 增益曲线实时图（03 §4：0x02/03/04 联动；虚线=本次会话上一组） -->
                    <GroupBox Grid.Row="1" Header="有效增益曲线（灵敏度 × 速度曲线：左段高度=小范围灵敏度，台阶位置=精细/速度分界，斜坡宽度=换挡柔和度）" Margin="4,0,4,4">
                        <StackPanel>
                            <Canvas Width="320" Height="150" Background="#FAFAFA" HorizontalAlignment="Left" Margin="4">
                                <Polyline Points="{Binding PrevCurvePoints}" Stroke="Gray" StrokeThickness="1"
                                          StrokeDashArray="3 2"/>
                                <Polyline Points="{Binding CurvePoints}" Stroke="#2C3E50" StrokeThickness="2"/>
                                <Line X1="{Binding KneeTickX}" Y1="8" X2="{Binding KneeTickX}" Y2="130"
                                      Stroke="#E67E22" StrokeThickness="1" StrokeDashArray="2 2"/>
                                <Line X1="{Binding WidthTickX}" Y1="8" X2="{Binding WidthTickX}" Y2="130"
                                      Stroke="#E67E22" StrokeThickness="1" StrokeDashArray="2 2"/>
                                <TextBlock Canvas.Left="{Binding KneeTickX}" Canvas.Top="132" FontSize="10"
                                           Foreground="#E67E22" Text="{Binding KneeTickText}"/>
                                <TextBlock Canvas.Left="{Binding WidthTickX}" Canvas.Top="132" FontSize="10"
                                           Foreground="#E67E22" Text="{Binding WidthTickText}"/>
                                <TextBlock Canvas.Left="2" Canvas.Top="4" FontSize="10" Foreground="Gray" Text="增益"/>
                                <TextBlock Canvas.Left="290" Canvas.Top="134" FontSize="10" Foreground="Gray" Text="50dps"/>
                                <TextBlock Canvas.Left="34" Canvas.Top="134" FontSize="10" Foreground="Gray" Text="0"/>
                            </Canvas>
                            <TextBlock Text="灰虚线 = 本次会话上一组（写 0x02/03/04 生效时自动留影）" FontSize="11"
                                       Foreground="Gray" Margin="8,0,0,4"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 联动助手（03 §5：0x01×0x02 嵌套；稳↔飘刻度尺 + 补偿建议） -->
                    <GroupBox Grid.Row="2" Header="0x01 × 0x02 嵌套助手（小范围手感 = 灵敏度 × 慢速段增益）" Margin="4,8,4,4"
                              IsEnabled="{Binding IsConnected}">
                        <StackPanel Margin="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding EffectiveGainText}" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Slider Minimum="0" Maximum="1" Value="{Binding StabilityValue, Mode=OneWay}"
                                        IsEnabled="False" IsMoveToPointEnabled="False" Width="160" Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="稳←→飘：指针位置=小范围有效增益相对基准（0.08）的倍率"/>
                                <TextBlock Text="稳" FontSize="11" Foreground="Gray" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StabilityScaleText}" FontSize="11" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Foreground="#2C3E50"/>
                                <TextBlock Text="飘" FontSize="11" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Background="#FEF9E7" CornerRadius="2" Padding="6,4" Margin="0,6,0,0"
                                    Visibility="{Binding SuggestionVisibility}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SuggestionText}" Foreground="#7D6608" TextWrapping="Wrap"
                                               MaxWidth="420" VerticalAlignment="Center"/>
                                    <Button Content="一键应用" Command="{Binding ApplySuggestionCommand}"
                                            Style="{StaticResource ActionButton}" MinWidth="70" Margin="10,0,0,0"/>
                                    <Button Content="忽略" Command="{Binding DismissSuggestionCommand}"
                                            Style="{StaticResource ActionButton}" MinWidth="44" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>
                </Grid>

                <!-- 右：会话面板（03 §6） -->
                <GroupBox Grid.Column="1" Header="会话面板" Margin="0,4,4,4" IsEnabled="{Binding IsConnected}">
                    <StackPanel Margin="4">
                        <!-- 方案快照 A/B -->
                        <TextBlock Text="方案快照（本地 configs/airmouse/，与 CLI param snapshot 互通）"
                                   Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBox Text="{Binding SnapshotNameInput, UpdateSourceTrigger=PropertyChanged}"
                                     Width="120" Padding="2,1" VerticalAlignment="Center"
                                     ToolTip="快照名，建议 A/B 便于互切对比手感"/>
                            <Button Content="存当前" Command="{Binding SaveSnapshotCommand}"
                                    Style="{StaticResource ActionButton}" MinWidth="56" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox ItemsSource="{Binding SnapshotNames}" SelectedItem="{Binding SelectedSnapshot}"
                                      Width="120" VerticalAlignment="Center"/>
                            <Button Content="应用" Command="{Binding ApplySnapshotCommand}"
                                    Style="{StaticResource ActionButton}" MinWidth="48" Margin="6,0,0,0"
                                    ToolTip="把快照 6 参依次写回笔端（A/B 一键互切）"/>
                            <Button Content="删除" Command="{Binding DeleteSnapshotCommand}"
                                    Style="{StaticResource ActionButton}" MinWidth="48" Margin="4,0,0,0"/>
                        </StackPanel>

                        <Separator Margin="0,10,0,4"/>
                        <Button Content="恢复出厂（6 参写回固件宏值）" Command="{Binding RestoreFactoryCommand}"
                                Style="{StaticResource ActionButton}" MinWidth="170" HorizontalAlignment="Left"/>

                        <Separator Margin="0,10,0,4"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="变更历史（本次会话）" Foreground="Gray" FontSize="11"/>
                            <ListBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding History}"
                                     Height="110" Margin="0,4,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11" TextWrapping="Wrap">
                                            <Run Text="{Binding Time, Mode=OneWay}" Foreground="Gray"/>
                                            <Run Text="{Binding Change, Mode=OneWay}"/>
                                            <Run Text="{Binding Source, Mode=OneWay, StringFormat=（{0}）}" Foreground="#2980B9"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="1" Grid.Column="1" Content="复制" Command="{Binding CopyHistoryCommand}"
                                    Style="{StaticResource ActionButton}" MinWidth="40" Margin="4,4,0,0"
                                    VerticalAlignment="Top"/>
                        </Grid>

                        <Separator Margin="0,10,0,4"/>
                        <TextBlock Text="导出宏片段（满意后交固件回填出包固化）" Foreground="Gray" FontSize="11"/>
                        <TextBox Text="{Binding ExportNote, UpdateSourceTrigger=PropertyChanged}" Padding="2,1"
                                 Margin="0,4,0,0" ToolTip="备注（随头部注释写入片段）"/>
                        <Button Content="导出宏片段（复制+存文件）" Command="{Binding ExportMacroCommand}"
                                Style="{StaticResource ActionButton}" MinWidth="170" Margin="0,6,0,0"
                                HorizontalAlignment="Left"/>

                        <Separator Margin="0,10,0,4"/>
                        <TextBlock Text="试手感清单（随快照存档）" Foreground="Gray" FontSize="11"/>
                        <StackPanel Margin="0,4,0,0">
                            <CheckBox Content="单击准" IsChecked="{Binding CheckClickAccurate}" Margin="0,2"/>
                            <CheckBox Content="双击原地" IsChecked="{Binding CheckDoubleClickInPlace}" Margin="0,2"/>
                            <CheckBox Content="瞄准小目标不飘" IsChecked="{Binding CheckAimStable}" Margin="0,2"/>
                            <CheckBox Content="快甩到位" IsChecked="{Binding CheckFlingReach}" Margin="0,2"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
