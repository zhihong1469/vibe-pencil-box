<UserControl x:Class="PencilBox.Desktop.Views.ProductHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:proto="clr-namespace:PencilBox.Core.Protocol;assembly=PencilBox.Core"
             xmlns:ctrl="clr-namespace:PencilBox.Desktop.Controls"
             xmlns:vm="clr-namespace:PencilBox.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <x:Array x:Key="EventTypeOptions" Type="{x:Type proto:KeyEventType}">
            <proto:KeyEventType>Click</proto:KeyEventType>
            <proto:KeyEventType>DoubleClick</proto:KeyEventType>
            <proto:KeyEventType>LongPress</proto:KeyEventType>
            <proto:KeyEventType>LongRelease</proto:KeyEventType>
        </x:Array>
        <x:Array x:Key="ActionTypeOptions" Type="{x:Type proto:KeyActionType}">
            <proto:KeyActionType>None</proto:KeyActionType>
            <proto:KeyActionType>Keyboard</proto:KeyActionType>
            <proto:KeyActionType>MouseButton</proto:KeyActionType>
            <proto:KeyActionType>Consumer</proto:KeyActionType>
            <proto:KeyActionType>Special</proto:KeyActionType>
        </x:Array>
    </UserControl.Resources>

    <!-- 弹性窗口：整页滚动兜底（窄/矮窗口不再裁剪遮挡；Keymap 表自身另有滚动） -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========== 设备连接区（接收器 + 笔端绑定） ========== -->
            <GroupBox Grid.Row="0" Header="接收器连接" Margin="4">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="120"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableDevices}"
                                  SelectedItem="{Binding SelectedDevice}" Margin="4"
                                  ToolTip="接口号+接口名：每一条唯一可区分；★=命令通道接口（读电量/协议）">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="★ " Foreground="#E67E22" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsCommandChannel, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding InterfaceLabel}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Content="扫描" Command="{Binding ScanDevicesCommand}"
                                Style="{StaticResource ActionButton}"/>
                        <Button Grid.Column="2" Content="连接" Command="{Binding ConnectCommand}"
                                Style="{StaticResource ActionButton}" IsEnabled="{Binding CanConnect}"/>
                        <Button Grid.Column="3" Content="断开" Command="{Binding DisconnectCommand}"
                                Style="{StaticResource ActionButton}" IsEnabled="{Binding IsConnected}"/>
                        <Button Grid.Column="4" Content="刷新状态" Command="{Binding RefreshStateCommand}"
                                Style="{StaticResource ActionButton}" IsEnabled="{Binding IsConnected}"/>
                    </Grid>

                    <!-- 取 MAC 的两条来源（**统一存储**）：① 蓝牙扫描 ② 串口 0x51 读笔端
                         —— 产物汇入同一份目录，故"绑定"只有一条下发路径（0x51 写，显示序直传、PC 零转换） -->
                    <Grid Margin="4,6,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="160"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="连接目标：" VerticalAlignment="Center"
                                   Foreground="#555" MinWidth="68"/>
                        <ComboBox Grid.Column="1" Margin="0,0,8,0" MinWidth="180"
                                  ItemsSource="{Binding PenTargets}"
                                  SelectedItem="{Binding SelectedPen}"
                                  ToolTip="已知笔端目录（统一存储，与来源无关）：按 上次使用 > 使用过 > 出现过 分级，层内在场+信号降序；已保存设备即使不在场也能下发（基站拿到 MAC 后设备一出现即建联）">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#ECF0F1" CornerRadius="3" Padding="4,0" Margin="0,0,6,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LevelName}" FontSize="10"
                                                       Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Background="#EAF2F8" CornerRadius="3" Padding="4,0" Margin="0,0,6,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SourceName}" FontSize="10"
                                                       Foreground="#2471A3" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding MacDisplayText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Text=" " VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LocalName}" Foreground="#666" VerticalAlignment="Center"/>
                                        <TextBlock Text=" " VerticalAlignment="Center"/>
                                        <TextBlock Text="在场" Foreground="#27AE60" FontSize="11" VerticalAlignment="Center"
                                                   Visibility="{Binding IsPresent, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding Rssi, StringFormat={}{0}dBm}" Foreground="#999" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2" Content="扫描笔端" Command="{Binding ScanPensCommand}"
                                Style="{StaticResource ActionButton}" Margin="0,0,8,0" IsEnabled="{Binding IsScanningBle, Converter={StaticResource InvertBoolConverter}}"
                                ToolTip="来源①：蓝牙广播扫描（权威 MAC 取广播地址；广播名尾号仅作展示/校验）"/>
                        <Button Grid.Column="3" Content="绑定" Command="{Binding BindPenCommand}"
                                Style="{StaticResource ActionButton}" IsEnabled="{Binding CanBind}"
                                ToolTip="把选中笔端的 MAC（显示序，PC 零转换）经 0x51 写下发基站并回读校验"/>
                        <Button Grid.Column="4" Content="用户配对模式" Command="{Binding PairByNameCommand}"
                                Style="{StaticResource ActionButton}" Margin="8,0,0,0" IsEnabled="{Binding IsConnected}"
                                ToolTip="0x52 进配对：让基站进入名称配对模式（匹配 SunVote-R1#），由基站自行扫描学习笔端 MAC"/>
                        <Button Grid.Column="5" Content="清除记录" Command="{Binding ClearPenTargetsCommand}"
                                Style="{StaticResource ActionButton}" Margin="8,0,0,0" IsEnabled="{Binding HasPenTargets}"
                                ToolTip="清空本地已知笔端目录（出现/使用历史全部抹掉，长期累积后手动整理用）；不影响已下发到基站的绑定（基站侧解绑走下方 A3 清目标；笔端本体解绑走「串口直达笔端」行的清绑定）"/>
                    </Grid>

                    <!-- 来源②：串口直达笔端（工厂/产测更可靠）——**笔端动作只在此路径**：
                         读 MAC（0x51 读）与 清绑定（0x51/03）都经同一串口直发笔端；BLE 透传不提供清绑定（防误清） -->
                    <Grid Margin="4,2,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="串口直达笔端：" VerticalAlignment="Center"
                                   Foreground="#555" MinWidth="96"/>
                        <ComboBox Grid.Column="1" Width="130" Margin="0,0,8,0"
                                  ItemsSource="{Binding SerialPorts}"
                                  SelectedItem="{Binding SelectedSerialPort}"
                                  ToolTip="笔端串口（115200,N,8,1）；读取时不会施加 DTR/RTS（避免复位笔端）"/>
                        <Button Grid.Column="2" Content="刷新端口" Command="{Binding LoadSerialPortsCommand}"
                                Style="{StaticResource ActionButton}" Margin="0,0,8,0"
                                ToolTip="重新枚举本机串口"/>
                        <Button Grid.Column="3" Content="读取 MAC（0x51）" Command="{Binding ReadPenBySerialCommand}"
                                Style="{StaticResource ActionButton}"
                                IsEnabled="{Binding CanReadPenBySerial}"
                                ToolTip="来源②：串口直连笔端发 0x51 读配对信息（笔端恒回自身 MAC + BT_NAME），并入同一份目录"/>
                        <Button Grid.Column="4" Content="清绑定（0x51/03）" Command="{Binding ClearPenBindingCommand}"
                                Style="{StaticResource ActionButton}" Margin="8,0,0,0" HorizontalAlignment="Left"
                                IsEnabled="{Binding CanClearBinding}"
                                ToolTip="笔端动作 · 仅串口直达：笔端删自身 bond → 断连 → 配对视窗 60s（副作用需确认）；BLE 透传路径不提供（补充 01 §1 防误清）"/>
                    </Grid>

                    <StackPanel Margin="96,0,4,4">
                        <TextBlock Foreground="#666" FontSize="11"
                                   Text="{Binding SelectedPenDisplayMac, StringFormat=显示序 MAC（下发值，零转换）: {0}}"
                                   Visibility="{Binding SelectedPen, Converter={StaticResource NullToVisConverter}}"/>
                        <TextBlock Foreground="#666" FontSize="11"
                                   Text="{Binding SelectedPenSummary}"
                                   Visibility="{Binding SelectedPen, Converter={StaticResource NullToVisConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- ========== 状态卡片区（WrapPanel：窄窗自动折行，不再横向裁剪） ========== -->
            <WrapPanel Grid.Row="1" Margin="4">

                <!-- 电池仪表盘 -->
                <GroupBox Header="笔端电量" Padding="12" MinWidth="170" HorizontalAlignment="Left">
                    <StackPanel>
                        <ctrl:BatteryGaugeControl Value="{Binding BatteryLevel}" Title="电量"
                                                  ChargeText="{Binding GaugeChargeText}" ChargeBrush="{Binding GaugeChargeBrush}"
                                                  ValueBrush="{Binding GaugeValueBrush}"
                                                  ToolTip="充电中 % 灰显=电压虚高、读数仅供参考（数字保持可见）；拔出后笔端清窗快速回落真实值"
                                                  Width="120" Height="120" Opacity="{Binding HasPenTelemetry, Converter={StaticResource BoolToOpacityConverter}}"/>
                        <TextBlock Text="未获取：点「刷新笔端状态」（0x53）" FontSize="10" Foreground="#B03A2E"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasPenTelemetry, Converter={StaticResource InvertBoolConverter}}"/>
                    </StackPanel>
                </GroupBox>

                <!-- 蓝牙信号 -->
                <GroupBox Header="蓝牙信号" Padding="12" MinWidth="140" Margin="8,0,0,0" HorizontalAlignment="Left">
                    <StackPanel>
                        <ctrl:SignalIndicatorControl IsConnected="{Binding PencilConnected}"
                                                     Rssi="{Binding Rssi}" Width="90" Height="80"
                                                     Opacity="{Binding HasPenTelemetry, Converter={StaticResource BoolToOpacityConverter}}"/>
                        <TextBlock Text="未获取：点「刷新笔端状态」（RSSI 走 0x53 槽 0x03，需新基站固件）" FontSize="10" Foreground="#B03A2E"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasPenTelemetry, Converter={StaticResource InvertBoolConverter}}"/>
                    </StackPanel>
                </GroupBox>

                <!-- 充电状态 / 连接状态 / 设备状态（0x53 实际数值；工作模式已退役=凭 F13~F16 自推导，V1.3） -->
                <GroupBox Header="笔端状态" Padding="12" MinWidth="220" Margin="8,0,0,0" HorizontalAlignment="Left">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PencilStateText}" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PenChargeStateText}" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Visibility="{Binding HasPenTelemetry, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding PenDevStateText, StringFormat=设备状态：{0}}" FontSize="12"
                                   Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding WorkStateText, StringFormat=工作状态：{0}}" FontSize="12"
                                   Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,2,0,0"
                                   ToolTip="笔端工作状态自管：凭 Keymap 触发键（出厂 F13~F16）边界事件自推导「识别×扩音」两轴；断连回「待事件」"/>
                        <TextBlock Text="未获取：点「刷新笔端状态」（0x53）" FontSize="10" Foreground="#B03A2E"
                                   HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasPenTelemetry, Converter={StaticResource InvertBoolConverter}}"/>
                        <TextBlock Text="{Binding PenStatusMetaText}" FontSize="10" Foreground="#7F8C8D"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Button Content="刷新笔端状态" Command="{Binding RefreshPenStatusCommand}"
                                    Style="{StaticResource ActionButton}" IsEnabled="{Binding IsConnected}"
                                    ToolTip="0x53 拉取快照（基站槽缓存即答）：电量 / 休眠 / 充电状态 / 信号（RSSI 槽 0x03）"/>
                            <Button Command="{Binding TogglePenPushListenCommand}" Margin="8,0,0,0"
                                    IsEnabled="{Binding IsConnected}"
                                    ToolTip="0x53 E1 推送实时上卡：连笔全量 / 电量·休眠变化 / 断连 STATUS=02">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                        <Setter Property="Content" Value="开启推送监听"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPenPushListening}" Value="True">
                                                <Setter Property="Content" Value="停止推送监听"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- K2 启动方式（0x54 信封 0x21/0x42：路径 = **BLE 透传**，USB 信封 → 基站 → 当前连接笔端；
                     笔端的另一条触达路径 = 上方「串口直达笔端」行，按命令轨约束分工） -->
                <GroupBox Header="K2 启动方式（0x54 · BLE 透传）" Padding="12" MinWidth="250" Margin="8,0,0,0" HorizontalAlignment="Left">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="路径：USB 信封 → 基站 → 当前连接笔端（串口直达不在此卡）"
                                   FontSize="10" Foreground="#7F8C8D" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <ComboBox Width="90" VerticalAlignment="Center"
                                      SelectedIndex="{Binding K2ModeIndex}"
                                      ToolTip="0x21 SET_VOICE_KEY_MODE：方式1 / 方式2（命令语义归统一TX 规范 §7）">
                                <ComboBoxItem Content="方式 1"/>
                                <ComboBoxItem Content="方式 2"/>
                            </ComboBox>
                            <Button Content="查询" Command="{Binding QueryK2ModeCommand}" Margin="8,0,0,0"
                                    Style="{StaticResource ActionButton}" IsEnabled="{Binding CanUseK2}"
                                    ToolTip="0x42 QUERY_VOICE_KEY_MODE：读笔端当前启动方式"/>
                            <Button Content="应用" Command="{Binding ApplyK2ModeCommand}" Margin="8,0,0,0"
                                    Style="{StaticResource ActionButton}" IsEnabled="{Binding CanUseK2}"
                                    ToolTip="0x21 下发所选方式（笔端 NVDS 掉电保持）；OTA 升级会话中自动排队让路（C5）"/>
                        </StackPanel>
                        <TextBlock Text="{Binding K2ModeResultText}" FontSize="11" Foreground="#2C3E50"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="230"/>
                    </StackPanel>
                </GroupBox>

                <!-- Dongle 配对状态（EP4 A1 GET_STATE）——**接收器侧**；笔端本体解绑在「串口直达笔端」行。
                     按钮（A1 手动刷新 / A3 清除目标）已于 2026-09-23 裁决摘除：设备侧 4A4C 已退役，对现行固件恒超时；
                     4A4C 遗留联调走 CLI device ep4 的 send（A1/A3），见 10 号 §4.2 -->
                <GroupBox Header="接收器·配对状态" Padding="12" MinWidth="290" Margin="8,0,0,0" HorizontalAlignment="Left">
                    <Grid>
                        <TextBlock Text="{Binding DonglePairText}"
                                   TextWrapping="Wrap" FontSize="13" Foreground="#2C3E50"
                                   Visibility="{Binding HasPairState, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding DonglePairText}"
                                   TextWrapping="Wrap" FontSize="13" Foreground="#95A5A6"
                                   Visibility="{Binding HasPairState, Converter={StaticResource InvertBoolConverter}}"/>
                    </Grid>
                </GroupBox>
            </WrapPanel>

            <!-- ========== Keymap 表格区 ========== -->
            <GroupBox Grid.Row="2" Header="快捷键映射（Keymap）" Margin="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 命名配置行（pc-issues/04 提案 B：exe 同级 configs/keymap/，一配置一 JSON；出厂默认只读）。
                         WrapPanel 弹性换行：窄窗按钮折行而非右裁（根 ScrollViewer 横向滚动已禁用）。
                         注意不得设 ItemHeight：ActionButton Height=32+Margin=4 实占 40，槽高 32 会削掉按钮底边 -->
                    <WrapPanel Grid.Row="0" Margin="4">
                        <TextBlock Text="配置：" VerticalAlignment="Center" Foreground="#555"/>
                        <ComboBox ItemsSource="{Binding KeymapConfigNames}"
                                  SelectedItem="{Binding SelectedKeymapConfig}"
                                  MinWidth="150" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="新建表" Command="{Binding NewKeymapConfigCommand}"
                                Style="{StaticResource ActionButton}"
                                ToolTip="从出厂默认复制新建命名配置（无固件参与；改好触发键即可用键盘自测工作状态自管）"/>
                        <Button Content="另存为…" Command="{Binding SaveKeymapConfigAsCommand}"
                                Style="{StaticResource ActionButton}"
                                ToolTip="把当前表格内容存为新配置（可对出厂默认另存后修改）"/>
                        <Button Content="保存" Command="{Binding SaveKeymapConfigCommand}"
                                Style="{StaticResource ActionButton}"
                                ToolTip="把表格修改保存回当前配置（出厂默认只读不可保存；命名配置可直接保存）"/>
                        <Button Content="改名" Command="{Binding RenameKeymapConfigCommand}"
                                Style="{StaticResource ActionButton}" Margin="8,0,0,0"
                                ToolTip="重命名当前配置（出厂默认不可改名）"/>
                        <Button Content="删除" Command="{Binding DeleteKeymapConfigCommand}"
                                Style="{StaticResource ActionButton}"
                                ToolTip="删除当前配置（出厂默认不可删）"/>
                        <Button Content="生效" Command="{Binding ApplyKeymapConfigCommand}"
                                Style="{StaticResource ActionButton}" Margin="8,0,0,0"
                                ToolTip="本机已随选中即时生效（K2/S1 触发键跟随当前配置），此键再把当前表整表下发基站（0x55 两段式）尽力同步；选中出厂默认=恢复设备默认表；未连接/未响应时仅本机生效"/>
                        <TextBlock Text="{Binding KeymapRows.Count, StringFormat=条目数: {0}}"
                                   VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666"/>
                    </WrapPanel>

                    <!-- 设备下发回归（2026-10-18 三改）：选表=本机立即生效；「生效」=整表尽力下发基站 0x55，
                         未连接/未响应/失败只降级提示不回滚（回执会丢，门控反致两端不同步）；老 0xA0"阶段 6"死协议不再复活 -->

                    <!-- 一键一卡（出厂默认整卡只读；行实例与 KeymapRows 共享，编辑即时互通） -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="430" Margin="4">
                        <StackPanel>
                        <ItemsControl ItemsSource="{Binding KeymapCards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="4"
                                            Margin="0,0,0,6" Background="#FDFEFE" Padding="8,6,8,8">
                                        <!-- 内容 980 封顶左靠：宽窗下"加事件/删行"聚在内容右侧，不被 * 列推到窗框边 -->
                                        <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                                            <!-- 卡头：键名徽章 + 只读标记 + 加事件 -->
                                            <Grid Margin="0,0,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#2C3E50" CornerRadius="3" Padding="6,2">
                                                        <TextBlock Text="{Binding KeyName}" Foreground="White"
                                                                   FontWeight="SemiBold" FontSize="12"/>
                                                    </Border>
                                                    <TextBlock Text="出厂默认（只读）" Foreground="#B03A2E" FontSize="11"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Visibility="{Binding IsEditable, Converter={StaticResource InvertBoolConverter}}"/>
                                                </StackPanel>
                                                <Button Content="＋ 事件" HorizontalAlignment="Right"
                                                        Style="{StaticResource ActionButton}" MinWidth="76"
                                                        IsEnabled="{Binding IsEditable}"
                                                        ToolTip="给这个键追加一条事件映射（如双击）"
                                                        Command="{Binding DataContext.AddKeymapRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                            <!-- 事件行 -->
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="96"/>
                                                                <ColumnDefinition Width="96"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="30"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- 事件：K2 行=会话边界契约锁定显示；其余可改 -->
                                                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding EventTypeName}" VerticalAlignment="Center"
                                                                           ToolTip="{Binding EventLockTip}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsK2Row}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <ComboBox ItemsSource="{StaticResource EventTypeOptions}"
                                                                          SelectedItem="{Binding EventType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          IsEnabled="{Binding CanEditEvent}" Margin="0,0,6,0">
                                                                    <ComboBox.Style>
                                                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsK2Row}" Value="False">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </ComboBox.Style>
                                                                </ComboBox>
                                                            </Grid>

                                                            <!-- 动作类型 -->
                                                            <ComboBox Grid.Column="1" Margin="0,0,6,0"
                                                                      ItemsSource="{StaticResource ActionTypeOptions}"
                                                                      SelectedItem="{Binding ActionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      IsEnabled="{Binding IsEditable}"/>

                                                            <!-- 动作编辑区：按动作类型切换（键盘=捕获 / 消费键·鼠标键=下拉 / 其他=CLI 指路） -->
                                                            <Grid Grid.Column="2" IsEnabled="{Binding IsEditable}">
                                                                <!-- 键盘动作：捕获框 + 修饰键 + 专用键（WrapPanel 弹性换行，窄窗不右裁） -->
                                                                <WrapPanel>
                                                                    <WrapPanel.Style>
                                                                        <Style TargetType="WrapPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ActionType}" Value="{x:Static proto:KeyActionType.Keyboard}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </WrapPanel.Style>
                                                                    <ctrl:KeyCaptureBox Width="190" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                        CapturedModifier="{Binding Modifier, Mode=TwoWay}"
                                                                        CapturedUsage="{Binding CodeLo, Mode=TwoWay}"
                                                                        ToolTip="点击获得焦点后按下快捷键（修饰键+单主键）；Esc 清除"/>
                                                                    <TextBlock Text="修饰键" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555"/>
                                                                    <CheckBox Content="Ctrl" IsChecked="{Binding HasCtrl}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                    <CheckBox Content="Shift" IsChecked="{Binding HasShift}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                                    <CheckBox Content="Alt" IsChecked="{Binding HasAlt}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                                    <TextBlock Text="专用键" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555"
                                                                               ToolTip="物理键盘不存在的保留键（F13~F16），系统零冲突——点它即设为该键值"/>
                                                    <ComboBox Width="168" VerticalAlignment="Center"
                                                              ItemsSource="{x:Static vm:KeymapRowViewModel.DedicatedKeys}"
                                                              DisplayMemberPath="Name"
                                                              SelectedItem="{Binding SelectedDedicatedKey, Mode=TwoWay}"/>
                                                                </WrapPanel>
                                                                <!-- 消费键：下拉预设 -->
                                                                <StackPanel Orientation="Horizontal">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ActionType}" Value="{x:Static proto:KeyActionType.Consumer}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <TextBlock Text="消费键" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555"/>
                                                                    <ComboBox Width="150" VerticalAlignment="Center"
                                                                              ItemsSource="{x:Static vm:KeymapRowViewModel.ConsumerPresets}"
                                                                              DisplayMemberPath="Name"
                                                                              SelectedItem="{Binding SelectedConsumerPreset, Mode=TwoWay}"/>
                                                                </StackPanel>
                                                                <!-- 鼠标键：下拉预设 -->
                                                                <StackPanel Orientation="Horizontal">
                                                                    <StackPanel.Style>
                                                                        <Style TargetType="StackPanel">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ActionType}" Value="{x:Static proto:KeyActionType.MouseButton}">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </StackPanel.Style>
                                                                    <TextBlock Text="鼠标键" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555"/>
                                                                    <ComboBox Width="120" VerticalAlignment="Center"
                                                                              ItemsSource="{x:Static vm:KeymapRowViewModel.MouseButtonOptions}"
                                                                              DisplayMemberPath="Name"
                                                                              SelectedItem="{Binding SelectedMouseButtonPreset, Mode=TwoWay}"/>
                                                                </StackPanel>
                                                                <!-- 其他动作：指路 CLI -->
                                                                <TextBlock Text="（无动作/特殊功能/应用通知：请用 CLI pencilbox keymap set 配置）"
                                                                           VerticalAlignment="Center" Foreground="#999" FontSize="11">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ActionType}" Value="{x:Static proto:KeyActionType.Keyboard}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding ActionType}" Value="{x:Static proto:KeyActionType.Consumer}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding ActionType}" Value="{x:Static proto:KeyActionType.MouseButton}">
                                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>

                                                            <!-- 删行（可编辑配置的非 K2 行）；Padding=0 必须显式——ActionButton 样式 Padding=12,6
                                                                 会把 24px 定宽按钮的内容区吃成 0 宽，任何字符都渲染不出来 -->
                                                            <Button Grid.Column="3" Content="×" FontSize="14" FontWeight="Bold" Padding="0" Width="24" MinWidth="24" Height="24"
                                                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                                                    Style="{StaticResource ActionButton}"
                                                                    Visibility="{Binding IsDeletable, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="删除这条事件映射"
                                                                    Command="{Binding DataContext.RemoveKeymapRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- S1 档位开关卡（2026-10-17 起随配置可编辑；档位列锁定，键值=捕获/修饰位/专用键；设备写回待 0x55 PARAM 05/06） -->
                        <Border BorderBrush="#D5DBDB" BorderThickness="1" CornerRadius="4"
                                Background="#FDFEFE" Padding="8,6,8,8">
                            <!-- 与按键卡同口径：内容 980 封顶左靠，宽窗不把说明文字行拉散 -->
                            <StackPanel MaxWidth="980" HorizontalAlignment="Left">
                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#2C3E50" CornerRadius="3" Padding="6,2">
                                            <TextBlock Text="S1 档位开关" Foreground="White"
                                                       FontWeight="SemiBold" FontSize="12"/>
                                        </Border>
                                        <TextBlock Text="出厂默认（只读）" Foreground="#B03A2E" FontSize="11"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding DataContext.IsFactoryConfigSelected, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="S1 三档开关：OFF=关机不上报；ON/SPK=扩音开关（切档上报右侧热键）" Foreground="#999"
                                                   FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding SwitchRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,0">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Style.Triggers>
                                                            <!-- IDLE 行=基站内部行，不进快捷键 UI（配置内保留保真固件表，0x55 逐槽编址） -->
                                                            <DataTrigger Binding="{Binding IsInternalRow}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="82"/>
                                                    <ColumnDefinition Width="96"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 档位（锁定：行不可增删） -->
                                                <TextBlock Grid.Column="0" Text="{Binding ModeName}" VerticalAlignment="Center"
                                                           ToolTip="{Binding InternalLockTip}"/>
                                                <TextBlock Grid.Column="1" Text="键盘" VerticalAlignment="Center" Foreground="#555"/>

                                                <!-- 键值编辑（与按键行键盘动作同交互；切换表为单码字节，无消费键/鼠标键预设；WrapPanel 弹性换行） -->
                                                <WrapPanel Grid.Column="2" IsEnabled="{Binding EditorEnabled}">
                                                    <ctrl:KeyCaptureBox Width="190" VerticalAlignment="Center" Margin="0,0,8,0"
                                                        CapturedModifier="{Binding Modifier, Mode=TwoWay}"
                                                        CapturedUsage="{Binding CodeLo, Mode=TwoWay}"
                                                        ToolTip="点击获得焦点后按下快捷键（修饰键+单主键）；Esc 清除"/>
                                                    <TextBlock Text="修饰键" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555"/>
                                                    <CheckBox Content="Ctrl" IsChecked="{Binding HasCtrl}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <CheckBox Content="Shift" IsChecked="{Binding HasShift}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                    <CheckBox Content="Alt" IsChecked="{Binding HasAlt}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBlock Text="专用键" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#555"
                                                               ToolTip="物理键盘不存在的保留键（F13~F16，扩音/识别档出厂默认即 F15/F16），点它即设为该键值"/>
                                                    <ComboBox Width="168" VerticalAlignment="Center"
                                                              ItemsSource="{x:Static vm:KeymapRowViewModel.DedicatedKeys}"
                                                              DisplayMemberPath="Name"
                                                              SelectedItem="{Binding SelectedDedicatedKey, Mode=TwoWay}"/>
                                                </WrapPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </GroupBox>

            <!-- ========== 状态栏 ========== -->
            <StatusBar Grid.Row="3" Background="#F0F0F0">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </ScrollViewer>
</UserControl>
