<UserControl x:Class="PencilBox.Desktop.Views.DspPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="750">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. 文件选择 -->
        <GroupBox Header="Audio Source (PCM / WAV)" Grid.Row="0" Padding="8">
            <StackPanel>
                <DockPanel Margin="0,4">
                    <Button DockPanel.Dock="Right" Content="Browse..." Width="80" Height="26"
                            Command="{Binding BrowseFileCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"/>
                    <TextBox Text="{Binding InputFilePath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" Height="26" VerticalContentAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="{Binding FileInfo}" Foreground="#666" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- 2. 参数设置 -->
        <GroupBox Header="Analysis Settings" Grid.Row="1" Padding="8" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Script" FontSize="12" Foreground="#555"/>
                    <ComboBox Width="220" Height="26" Margin="0,4,0,0"
                              ItemsSource="{Binding Scripts}"
                              SelectedItem="{Binding SelectedScript}"
                              DisplayMemberPath="Name"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Sample Rate (Hz)" FontSize="12" Foreground="#555"/>
                    <TextBox Width="110" Height="26" Margin="0,4,0,0"
                             Text="{Binding SampleRate, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"/>
                </StackPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Max FIR Taps" FontSize="12" Foreground="#555"/>
                    <TextBox Width="90" Height="26" Margin="0,4,0,0"
                             Text="{Binding MaxTaps, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Run Script" Width="90" Height="28" Margin="0,0,8,0"
                                Command="{Binding RunScriptCommand}"
                                Background="#2196F3" Foreground="White"/>
                        <Button Content="Full Analyze" Width="100" Height="28" Margin="0,0,8,0"
                                Command="{Binding AnalyzeFullCommand}"
                                Background="#4CAF50" Foreground="White"/>
                        <Button Content="Clear" Width="60" Height="28"
                                Command="{Binding ClearResultCommand}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 3. 进度 -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding ProgressText}" FontSize="12" Foreground="#555"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ProgressBar Grid.Column="1" Height="14" Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent}"/>
        </Grid>

        <!-- 4. 状态 + 摘要 -->
        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#2196F3"/>
            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#4CAF50"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 5. 结果 -->
        <GroupBox Header="Result" Grid.Row="4" Margin="0,8,0,0" Padding="4">
            <TextBox Text="{Binding ResultText}" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="12"
                     TextWrapping="NoWrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     Background="#1E1E1E" Foreground="#D4D4D4"
                     BorderThickness="0"/>
        </GroupBox>
    </Grid>
</UserControl>
