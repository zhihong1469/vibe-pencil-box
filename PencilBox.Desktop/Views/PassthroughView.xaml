<UserControl x:Class="PencilBox.Desktop.Views.PassthroughView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 设备与参数 -->
        <GroupBox Grid.Row="0" Header="扩音链路（录音设备 → 扬声器实时直通）" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="录音设备:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Grid.Row="0" Grid.Column="1"
                          ItemsSource="{Binding CaptureDevices}"
                          SelectedItem="{Binding SelectedCaptureDevice}" Margin="4"/>
                <Button Grid.Row="0" Grid.Column="2" Content="刷新" Margin="4"
                        Command="{Binding RefreshDevicesCommand}" Style="{StaticResource ActionButton}"/>

                <TextBlock Text="播放设备:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Grid.Row="1" Grid.Column="1"
                          ItemsSource="{Binding RenderDevices}"
                          SelectedItem="{Binding SelectedRenderDevice}" Margin="4"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="空 = 系统默认扬声器" FontSize="11"
                           Foreground="Gray" VerticalAlignment="Center" Margin="4"/>

                <TextBlock Text="桥接副汇:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Grid.Row="2" Grid.Column="1"
                          ItemsSource="{Binding RenderDevices}"
                          SelectedItem="{Binding SelectedBridgeDevice}" Margin="4"
                          ToolTip="把降噪后的信号复投到第二设备（如虚拟声卡），其他软件可把它当已降噪麦克风用。副汇丢最旧保最新，绝不反压主链——不影响扩音延迟。空 = 关。"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="空 = 关（主链零影响）" FontSize="11"
                           Foreground="Gray" VerticalAlignment="Center" Margin="4"/>

                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="4">
                    <TextBlock Text="音量:" VerticalAlignment="Center"/>
                    <Slider Minimum="0" Maximum="100" Value="{Binding VolumeSlider}" MinWidth="160" Margin="8,0"
                            VerticalAlignment="Center"
                            ToolTip="对数刻度：0=1x，100=24x。软件增益超过 1x 时内置限制器自动防破音（统计里可见是否触顶）。"/>
                    <TextBlock Text="{Binding Volume, StringFormat={}{0:F2}x}" Width="52" VerticalAlignment="Center"/>
                    <TextBlock Text="渲染缓冲:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Slider Minimum="10" Maximum="200" Value="{Binding RenderLatencyMs}" MinWidth="160" Margin="8,0"
                            VerticalAlignment="Center"
                            ToolTip="扬声器播放端缓冲（ms）：引擎附加延迟的主要来源。越小延迟越低，但欠载（卡顿）越敏感；建议 15~40ms。"/>
                    <TextBlock Text="{Binding RenderLatencyMs, StringFormat={}{0}ms}" Width="52" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 控制 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,4">
            <Button Content="开始扩音" Command="{Binding StartCommand}" IsEnabled="{Binding IsIdleOrStopped}"
                    Style="{StaticResource ActionButton}" MinWidth="110" Margin="4"/>
            <Button Content="停止" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}"
                    Style="{StaticResource ActionButton}" MinWidth="110" Margin="4"/>
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="#2C3E50"/>
        </StackPanel>

        <!-- 音频处理链（开关按信号处理顺序排列；运行中可即时切换；自动/手动两档调参） -->
        <GroupBox Grid.Row="2" Header="音频处理（按信号顺序，可按需开关）" Margin="4">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,3">
                    <TextBlock Text="带通降噪（切机械抖动/低频传导与高频嘶声；位于 AEC 之前）" VerticalAlignment="Center"/>
                    <TextBlock Text="低切 HPF:" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Slider Minimum="0" Maximum="400" TickFrequency="20" IsSnapToTickEnabled="True"
                            Value="{Binding HpfSlider}" MinWidth="130" Margin="6,0" VerticalAlignment="Center"
                            ToolTip="低于此频率全部滤除（两节 24dB/oct）。切机械抖动/腔体低频共振：默认 80Hz，机械振动明显可提到 120~150Hz；拉到 0（或 &lt;40）即关闭。运行中拖动即时生效。"/>
                    <TextBlock Text="{Binding HpfDisplay, StringFormat={}{0}}" Width="46" VerticalAlignment="Center"/>
                    <TextBlock Text="高切 LPF:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Slider Minimum="0" Maximum="7800" TickFrequency="200" IsSnapToTickEnabled="True"
                            Value="{Binding LpfSlider}" MinWidth="130" Margin="6,0" VerticalAlignment="Center"
                            ToolTip="高于此频率全部滤除（两节 24dB/oct）。切高频嘶声/超声残余；&lt;2000 视为关闭（默认关）。运行中拖动即时生效。"/>
                    <TextBlock Text="{Binding LpfDisplay, StringFormat={}{0}}" Width="46" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,3">
                    <TextBlock Text="定点滤除（电机/变压器单频啸声；真实频率先实测：录音 → dsp run --script fft_analysis 看 dominant）"
                               VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
                    <TextBlock Text="中心Hz:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBox Text="{Binding NotchText, UpdateSourceTrigger=PropertyChanged}" MinWidth="110" Margin="6,0"
                             VerticalAlignment="Center"
                             ToolTip="逗号分隔多个中心频率，如 1000 或 1000,2000（连谐波一起挖）。空=关；运行中输入即时生效。带宽≈中心/Q。"/>
                    <TextBlock Text="坑宽Q:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Slider Minimum="5" Maximum="50" Value="{Binding NotchQSlider}" MinWidth="100" Margin="6,0"
                            VerticalAlignment="Center"
                            ToolTip="Q=中心频率/坑宽：Q25@1kHz 即坑宽 40Hz。越大坑越窄（伤人声越少），太小会挖掉附近人声。"/>
                    <TextBlock Text="{Binding NotchQSlider, StringFormat={}{0:F0}}" Width="30" VerticalAlignment="Center"/>
                </StackPanel>

                <CheckBox Grid.Row="2" Grid.Column="0" Content="回声消除 AEC（扩音出声时开；戴耳机监听可关）"
                          IsChecked="{Binding AecEnabled}" VerticalAlignment="Center" Margin="2,3"/>
                <CheckBox Grid.Row="2" Grid.Column="1" Content="手动调参" IsChecked="{Binding AecManual}"
                          VerticalAlignment="Center" Margin="16,3,2,3"
                          ToolTip="缺省=自动档（教科书预设：残余抑制 40dB / 双讲 15dB）。勾选后开放滑条，边调边听边学。"/>
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            IsEnabled="{Binding AecManual}" Margin="4,0,0,0">
                    <TextBlock Text="残余抑制:" VerticalAlignment="Center"/>
                    <Slider Minimum="10" Maximum="60" Value="{Binding AecSuppressDb}" MinWidth="110" Margin="6,0"
                            VerticalAlignment="Center"
                            ToolTip="单讲（笔端说话、本端安静）时对残余回声的压制深度。越大回声越小，过大可能伤到本端语音。"/>
                    <TextBlock Text="{Binding AecSuppressDb, StringFormat={}{0:F0}dB}" Width="42" VerticalAlignment="Center"/>
                    <TextBlock Text="双讲抑制:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Slider Minimum="3" Maximum="40" Value="{Binding AecSuppressActiveDb}" MinWidth="110" Margin="6,0"
                            VerticalAlignment="Center"
                            ToolTip="双讲（双方同时说话）时的压制深度。越小双讲越保真、打断感越好，但残余回声越多。"/>
                    <TextBlock Text="{Binding AecSuppressActiveDb, StringFormat={}{0:F0}dB}" Width="42" VerticalAlignment="Center"/>
                </StackPanel>

                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="24,1,2,3"
                          Content="条件触发（实验）：参考静音满 500ms 自动旁路 AEC，参考一响立即恢复"
                          IsChecked="{Binding AecGateEnabled}"
                          ToolTip="判据取参考信号（要播出的声音）而非麦克风——参考静音才不可能有新回声。效果需人工听感确认，默认关。"/>

                <CheckBox Grid.Row="4" Grid.Column="0" Content="噪声抑制 ANS（含 AEC 残余处理；位于 AEC 之后）"
                          IsChecked="{Binding AnsEnabled}" VerticalAlignment="Center" Margin="2,3"/>
                <CheckBox Grid.Row="4" Grid.Column="1" Content="手动调参" IsChecked="{Binding AnsManual}"
                          VerticalAlignment="Center" Margin="16,3,2,3"
                          ToolTip="缺省=自动档（教科书预设 15dB）。勾选后开放滑条。"/>
                <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            IsEnabled="{Binding AnsManual}" Margin="4,0,0,0">
                    <TextBlock Text="降噪强度:" VerticalAlignment="Center"/>
                    <Slider Minimum="0" Maximum="35" Value="{Binding AnsNoiseSuppressDb}" MinWidth="110" Margin="6,0"
                            VerticalAlignment="Center"
                            ToolTip="稳态底噪压制深度。0≈不压底噪；越大底噪越干净，但语音越闷（高频音乐感损失）。"/>
                    <TextBlock Text="{Binding AnsNoiseSuppressDb, StringFormat={}{0:F0}dB}" Width="42" VerticalAlignment="Center"/>
                </StackPanel>

                <CheckBox Grid.Row="5" Grid.Column="0" Content="啸叫移频 AFC（破坏啸叫相位相干；轻微音质代价，默认关）"
                          IsChecked="{Binding AfcEnabled}" VerticalAlignment="Center" Margin="2,3"/>
                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="峰值限制器常开（防破音保护，不占开关）" FontSize="11" Foreground="Gray" Margin="2,4,0,0"/>
                <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="{Binding ChainWarning}" TextWrapping="Wrap" FontSize="11"
                           Foreground="DarkOrange" Margin="2,3,0,0"
                           Visibility="{Binding ChainWarningVisibility}"/>
            </Grid>
        </GroupBox>

        <!-- 电平 -->
        <GroupBox Grid.Row="3" Header="输入电平" Margin="4">
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding CurrentLevel}" Height="14" Margin="4"/>
        </GroupBox>

        <!-- 运行统计（环形缓冲深度 ≈ 引擎附加延迟活量；DSP耗时 = 实时性观测） -->
        <GroupBox Grid.Row="4" Header="运行统计" Margin="4">
            <TextBlock Text="{Binding StatsSummary}" Margin="6" TextWrapping="Wrap"/>
        </GroupBox>

        <!-- 延迟快测（box/07 §2.1：扫频脉冲串 → 格点跟踪互相关；CLI audio latency-probe 同源同口径） -->
        <GroupBox Grid.Row="5" Header="延迟快测（扬声器发声 → 录音设备收回，闭环延迟）" Margin="4" Padding="4">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4,2">
                    <Button Content="开始测量" Command="{Binding RunLatencyProbeCommand}"
                            IsEnabled="{Binding IsIdleOrStopped}"
                            Style="{StaticResource ActionButton}" MinWidth="110" Margin="4"
                            ToolTip="播一串扫频脉冲并用所选录音设备收回，格点跟踪互相关定位逐个延迟后取统计。测量期间保持安静、别挪麦克风。"/>
                    <TextBlock Text="脉冲数:" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <ComboBox ItemsSource="{Binding ProbePulseChoices}" SelectedItem="{Binding ProbePulses}"
                              MinWidth="60" Margin="4,0" VerticalAlignment="Center"
                              ToolTip="脉冲越多统计越稳，但测量窗口越长；CLI 对应 --pulses。"/>
                    <TextBlock Text="{Binding ProbeEstimatedWindow, StringFormat=预计 {0}（保持安静）}"
                               VerticalAlignment="Center" Margin="4,0" FontSize="11" Foreground="Gray"/>
                    <TextBlock Text="测距离影响：一次测一个位置，测完挪麦再测下一轮；别在测量中途走动。"
                               VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11"
                               Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Text="{Binding ProbeResult}" Margin="8,4" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>
    </Grid>
    </ScrollViewer>
</UserControl>
