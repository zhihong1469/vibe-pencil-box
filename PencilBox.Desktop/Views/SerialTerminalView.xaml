<UserControl x:Class="PencilBox.Desktop.Views.SerialTerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="750">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Port settings -->
        <GroupBox Grid.Row="0" Header="Serial Port Settings" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Port:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailablePorts}" 
                          SelectedItem="{Binding SelectedPort}" Margin="4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock Text="Baud:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Grid.Row="0" Grid.Column="3" ItemsSource="{Binding BaudRates}" 
                          SelectedItem="{Binding BaudRate}" IsEditable="True" Margin="4"/>

                <TextBlock Text="Data:" Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Grid.Row="0" Grid.Column="5" ItemsSource="{Binding DataBitsList}" 
                          SelectedItem="{Binding DataBits}" Margin="4"/>

                <Button Grid.Row="0" Grid.Column="6" Content="Refresh" Command="{Binding RefreshPortsCommand}" 
                        Style="{StaticResource ActionButton}" Margin="4"/>

                <TextBlock Text="Stop:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding StopBitsList}" 
                          SelectedIndex="{Binding SelectedStopBitsIndex}" Margin="4"/>

                <TextBlock Text="Parity:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding ParityList}" 
                          SelectedIndex="{Binding SelectedParityIndex}" Margin="4"/>

                <Button Grid.Row="1" Grid.Column="5" Content="Connect" Command="{Binding ConnectCommand}" 
                        Style="{StaticResource ActionButton}" IsEnabled="{Binding IsConnected, Converter={StaticResource InvertBoolConverter}}" Margin="4"/>
                <Button Grid.Row="1" Grid.Column="6" Content="Disconnect" Command="{Binding DisconnectCommand}" 
                        Style="{StaticResource ActionButton}" IsEnabled="{Binding IsConnected}" Margin="4"/>
            </Grid>
        </GroupBox>

        <!-- Send -->
        <GroupBox Grid.Row="1" Header="Send" Margin="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SendText}" Margin="4" 
                         AcceptsReturn="False" VerticalContentAlignment="Center"/>
                <CheckBox Grid.Column="1" Content="HEX" IsChecked="{Binding IsHexMode}" VerticalAlignment="Center" Margin="8,4"/>
                <CheckBox Grid.Column="2" Content="Timestamp" IsChecked="{Binding ShowTimestamp}" VerticalAlignment="Center" Margin="8,4"/>
                <Button Grid.Column="3" Content="Send" Command="{Binding SendCommand}" 
                        Style="{StaticResource ActionButton}" IsEnabled="{Binding IsConnected}" Margin="4"/>
            </Grid>
        </GroupBox>

        <!-- Received data -->
        <GroupBox Grid.Row="2" Header="Received / Log" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding ReceivedText, Mode=OneWay}" IsReadOnly="True" 
                             TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                             VerticalScrollBarVisibility="Auto" Margin="4"/>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4">
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
                    <Button Content="Clear" Command="{Binding ClearReceivedCommand}" Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
