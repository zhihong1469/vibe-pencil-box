<UserControl x:Class="PencilBox.Desktop.Views.SoftTriggerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1060">
    <!-- 软触发 v2（13 号；2026-10-19 指挥官目验反馈重排）：
         顶部=引擎状态 + 右上「＋ 新建」；中部=定义列表（新编排的从顶部向下生长，限高滚动）；
         底部=实时事件（沉底向上堆积）。编辑走弹窗（SoftTriggerEditDialog）——页面常态干净。 -->
    <Grid Margin="8,6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 标题行：引擎状态 + 新建按钮（右上角，指挥官指定） ============ -->
        <DockPanel Grid.Row="0" Margin="4,0,4,6">
            <Button DockPanel.Dock="Right" Content="＋ 新建软触发" Command="{Binding OpenNewCommand}"
                    Style="{StaticResource ActionButton}" MinWidth="110" Padding="12,5"
                    ToolTip="弹出编排窗口：触发键（全键盘±修饰）/ 序列步骤（可排序、步后延时）/ 连发 / 优先级"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="软触发" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="　本机键击回放——上位机纯软件，与设备连接无关" FontSize="12" Opacity="0.6"
                           VerticalAlignment="Center"/>
                <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="● 已停机"/>
                            <Setter Property="Foreground" Value="Gray"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EngineRunning}" Value="True">
                                    <Setter Property="Text" Value="● 运行中"/>
                                    <Setter Property="Foreground" Value="#2ECC71"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FeatureEnabled}" Value="False">
                                    <Setter Property="Text" Value="● 功能已停用"/>
                                    <Setter Property="Foreground" Value="#E67E22"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- ============ 定义列表（从顶部向下生长；限高滚动） ============ -->
        <GroupBox Grid.Row="1" Header="触发定义" Margin="4,0,4,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="（还没有软触发——点右上角「＋ 新建软触发」创建第一个：按下触发键 → 回放你编排的键序列）"
                           Margin="6,4" Opacity="0.6"
                           Visibility="{Binding EmptyHintVisibility}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              MaxHeight="420" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Definitions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6,4" Background="Transparent">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Command="{Binding DataContext.SetItemEnabledCommand,
                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                  CommandParameter="{Binding}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                                  ToolTip="启用/停用该定义（勾选即时生效）"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Note}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TriggerText}" VerticalAlignment="Center"
                                                   Foreground="#2980B9" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="{Binding SequenceText}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SequenceText}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding ModeText}" VerticalAlignment="Center"
                                                   FontSize="11" Opacity="0.7"/>
                                        <Button Grid.Column="5" Content="试射"
                                                Command="{Binding DataContext.FireCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButton}" MinWidth="48" Padding="0,4" Margin="3,0"
                                                ToolTip="不经钩子直接回放一遍（键击进当前前台窗口，请先切好焦点）"/>
                                        <Button Grid.Column="6" Content="编辑"
                                                Command="{Binding DataContext.EditCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButton}" MinWidth="48" Padding="0,4" Margin="3,0"
                                                ToolTip="弹窗重新编排"/>
                                        <Button Grid.Column="7" Content="删除"
                                                Command="{Binding DataContext.DeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ActionButton}" MinWidth="48" Padding="0,4" Margin="3,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </GroupBox>

        <!-- ============ 实时事件（沉底，向上堆积） ============ -->
        <GroupBox Grid.Row="2" Header="实时事件（引擎回放流水，新事件在上）" Margin="4,0,4,2">
            <ListBox ItemsSource="{Binding Events}" Height="130" FontSize="11"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Time, Mode=OneWay, StringFormat='HH:mm:ss.fff'}"/>
                            <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="{Binding Name, Mode=OneWay}"/>
                            <Run Text="{Binding Detail, Mode=OneWay}" Foreground="#777"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <TextBlock Grid.Row="3" Text="{Binding LastMessage}" Margin="10,4,10,6" FontSize="12"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42"/>
    </Grid>
</UserControl>
