<UserControl x:Class="PencilBox.Desktop.Views.AudioRecorderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:PencilBox.Desktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="750">
    <UserControl.Resources>
        <conv:StateToProgressConverter x:Key="StateToProgressConverter"/>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Device selection -->
        <GroupBox Grid.Row="0" Header="USB Audio 1.0 Device" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Device:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Grid.Row="0" Grid.Column="1" 
                          ItemsSource="{Binding AvailableDevices}" 
                          SelectedItem="{Binding SelectedDevice}" Margin="4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}"/>
                                <TextBlock Text=" [USB]" FontWeight="Bold" Foreground="Green" 
                                           Visibility="{Binding IsUsbDevice, Converter={StaticResource BoolToVis}}" Margin="4,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Row="0" Grid.Column="2" Content="Refresh" Command="{Binding RefreshDevicesCommand}" Style="{StaticResource ActionButton}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Format:" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableFormats}" 
                          SelectedItem="{Binding SelectedFormat}" Margin="4">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayFormat}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- Capture control -->
        <GroupBox Grid.Row="1" Header="Capture Control" Margin="4">
            <StackPanel Orientation="Horizontal" Margin="4">
                <Button Content="Start" Command="{Binding StartCaptureCommand}" Style="{StaticResource ActionButton}"/>
                <Button Content="Stop" Command="{Binding StopCaptureCommand}" Style="{StaticResource ActionButton}"/>
                <Button Content="Save to File" Command="{Binding SaveToFileCommand}" Style="{StaticResource ActionButton}"/>
                <Button Content="Clear" Command="{Binding ClearDataCommand}" Style="{StaticResource ActionButton}"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </GroupBox>

        <!-- Capture status -->
        <GroupBox Grid.Row="2" Header="Capture Status &amp; Dropout Detection" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="State:" Grid.Row="0" Grid.Column="0" Margin="4" FontWeight="Bold"/>
                <TextBlock Text="{Binding CaptureState}" Grid.Row="0" Grid.Column="1" Margin="4"/>

                <TextBlock Text="Frames Captured:" Grid.Row="1" Grid.Column="0" Margin="4"/>
                <TextBlock Text="{Binding FrameCount}" Grid.Row="1" Grid.Column="1" Margin="4"/>

                <TextBlock Text="Duration (s):" Grid.Row="2" Grid.Column="0" Margin="4"/>
                <TextBlock Text="{Binding DurationSeconds, StringFormat=F1}" Grid.Row="2" Grid.Column="1" Margin="4"/>

                <TextBlock Text="Level:" Grid.Row="3" Grid.Column="0" Margin="4"/>
                <ProgressBar Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Height="16" Margin="4"
                             Value="{Binding CurrentLevel}"/>

                <TextBlock Text="Stats:" Grid.Row="4" Grid.Column="0" Margin="4"/>
                <TextBlock Text="{Binding StatsSummary}" Grid.Row="4" Grid.Column="1" Margin="4" 
                           TextWrapping="Wrap"/>

                <TextBlock Text="Progress:" Grid.Row="5" Grid.Column="0" Margin="4"/>
                <ProgressBar Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="100" Height="24" Margin="4"
                             IsIndeterminate="{Binding CaptureState, Converter={StaticResource StateToProgressConverter}}"/>
            </Grid>
        </GroupBox>

        <!-- Output settings -->
        <GroupBox Grid.Row="3" Header="Output" Margin="4">
            <StackPanel Orientation="Horizontal" Margin="4">
                <TextBlock Text="Last Saved:" VerticalAlignment="Center" Margin="4"/>
                <TextBlock Text="{Binding OutputFilePath}" VerticalAlignment="Center" Margin="4" Opacity="0.8"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
