<UserControl x:Class="PencilBox.Desktop.Views.MacroEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:PencilBox.Desktop.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="700">
    <UserControl.Resources>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Macro list -->
        <GroupBox Grid.Row="0" Header="Macros" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}" Margin="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsEnabled}" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"/>
                                <TextBlock Text="{Binding Description}" Grid.Column="2" Opacity="0.7" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding KeySequence.Count, StringFormat=Keys: {0}}" Grid.Column="3" VerticalAlignment="Center" Margin="4,0"/>
                                <TextBlock Text="{Binding LoopCount, StringFormat=Loop: {0}}" Grid.Column="4" VerticalAlignment="Center" Margin="4,0"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4">
                    <Button Content="Load" Command="{Binding LoadMacrosCommand}" Style="{StaticResource ActionButton}"/>
                    <Button Content="Execute" Command="{Binding ExecuteMacroCommand}" 
                            Style="{StaticResource ActionButton}"
                            IsEnabled="{Binding SelectedMacro, Converter={StaticResource NullToBoolConverter}}"/>
                    <Button Content="Stop" Command="{Binding StopExecutionCommand}" Style="{StaticResource ActionButton}"/>
                    <Button Content="Delete" Command="{Binding DeleteMacroCommand}" Style="{StaticResource ActionButton}"
                            IsEnabled="{Binding SelectedMacro, Converter={StaticResource NullToBoolConverter}}"/>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Create new macro -->
        <GroupBox Grid.Row="1" Header="Create / Record Macro" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Name:" Grid.Column="0" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Column="1" Text="{Binding NewMacroName}" Margin="4"/>
                    <TextBlock Text="Description:" Grid.Column="2" VerticalAlignment="Center" Margin="4"/>
                    <TextBox Grid.Column="3" Text="{Binding NewMacroDescription}" Margin="4"/>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="4">
                    <Button Content="Add Empty Macro" Command="{Binding AddMacroCommand}" Style="{StaticResource ActionButton}"/>
                    <Button Content="Record Keys" Command="{Binding RecordMacroCommand}" Style="{StaticResource ActionButton}"/>
                    <TextBlock Text="{Binding IsRecording, StringFormat=Recording: {0}}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Tip: First connect your Dongle on the Device tab, then create a macro and edit its key sequence in code or via recording." 
                           Foreground="Gray" Margin="4,8,4,0" TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>

        <!-- Selected macro details (read-only preview) -->
        <GroupBox Grid.Row="2" Header="Selected Macro Preview" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding SelectedMacro.Name, FallbackValue='No macro selected', StringFormat='Name: {0}'}" FontWeight="Bold" Margin="4"/>
                <TextBlock Grid.Row="1" Text="{Binding SelectedMacro.KeySequence.Count, StringFormat='Key count: {0}'}" Margin="4"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
