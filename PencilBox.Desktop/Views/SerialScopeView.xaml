<UserControl x:Class="PencilBox.Desktop.Views.SerialScopeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="1000">

    <!-- 串口页：设备日志 + F5 协议 → 统一时间轴（05 §3.5）。
         注意：这里**刻意不做"通用串口收发"** —— 那是市面串口助手的事（05 §5.5）。 -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 端口与启动设置 ===== -->
        <GroupBox Grid.Row="0" Header="端口与启动设置" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" MinWidth="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" MinWidth="80"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 端口 1 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="端口 1" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Margin="4"
                          ItemsSource="{Binding Ports}" SelectedItem="{Binding Port1}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="波特率" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Grid.Row="0" Grid.Column="3" Margin="4" IsEditable="True"
                          ItemsSource="{Binding BaudRates}"
                          Text="{Binding Baud1, UpdateSourceTrigger=LostFocus}"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="标签" VerticalAlignment="Center" Margin="4"/>
                <TextBox Grid.Row="0" Grid.Column="5" Margin="4" Text="{Binding Label1}"/>
                <Button Grid.Row="0" Grid.Column="6" Content="刷新端口" Margin="4"
                        Style="{StaticResource ToolbarButton}" Command="{Binding RefreshPortsCommand}"/>

                <!-- 端口 2（可选，可单独可同时） -->
                <CheckBox Grid.Row="1" Grid.Column="0" Content="同时抓" VerticalAlignment="Center" Margin="4"
                          IsChecked="{Binding UsePort2}"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="4" IsEnabled="{Binding UsePort2}"
                          ItemsSource="{Binding Ports}" SelectedItem="{Binding Port2}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="波特率" VerticalAlignment="Center" Margin="4"/>
                <ComboBox Grid.Row="1" Grid.Column="3" Margin="4" IsEditable="True" IsEnabled="{Binding UsePort2}"
                          ItemsSource="{Binding BaudRates}"
                          Text="{Binding Baud2, UpdateSourceTrigger=LostFocus}"/>
                <TextBlock Grid.Row="1" Grid.Column="4" Text="标签" VerticalAlignment="Center" Margin="4"/>
                <TextBox Grid.Row="1" Grid.Column="5" Margin="4" Text="{Binding Label2}" IsEnabled="{Binding UsePort2}"/>

                <!-- 启动前开关 -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Horizontal" Margin="4">
                    <TextBlock Text="启动前：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <CheckBox Content="清空原有日志" IsChecked="{Binding ClearOnStart}" VerticalAlignment="Center" Margin="4,4"
                              ToolTip="勾选 = 本次全新开始；取消 = 追加在旧日志之后"/>
                    <CheckBox Content="解码 F5 帧" IsChecked="{Binding DecodeFrames}" VerticalAlignment="Center" Margin="12,4"
                              ToolTip="把 F5 帧解成人类可读；取消则只落原始 HEX（仍定帧，不搅乱文本）"/>
                    <CheckBox Content="写 JSONL（机读）" IsChecked="{Binding JsonlEnabled}" VerticalAlignment="Center" Margin="12,4"/>
                    <TextBlock Text="轮转" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <TextBox MinWidth="90" Text="{Binding RotateText}" ToolTip="上限:份数，如 10M:10"/>
                </StackPanel>

                <!-- 动作 -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="7" Orientation="Horizontal" Margin="4">
                    <Button Content="{Binding StartButtonText}" Command="{Binding StartCommand}"
                            Style="{StaticResource ActionButton}"
                            IsEnabled="{Binding IsRunning, Converter={StaticResource InvertBoolConverter}}"/>
                    <Button Content="停止" Command="{Binding StopCommand}" Style="{StaticResource ActionButton}"
                            IsEnabled="{Binding IsRunning}"/>
                    <Button Content="清屏" Command="{Binding ClearScreenCommand}" Style="{StaticResource ActionButton}"
                            ToolTip="只清显示；日志文件继续落盘"/>
                    <Button Content="对拍" Command="{Binding CompareCommand}" Style="{StaticResource ActionButton}"
                            ToolTip="以统一时间轴为基准，把 PC 收发帧与设备日志对齐"/>
                    <Button Content="打开日志目录" Command="{Binding OpenLogDirCommand}" Style="{StaticResource ActionButton}"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- 纪律提示 + 日志落点 -->
                <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="7" Margin="4">
                    <TextBlock Text="{Binding PortHints}" Foreground="#B35A00" TextWrapping="Wrap" FontSize="11"/>
                    <TextBlock Foreground="#666666" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run Text="日志（三份同时保留）："/>
                        <Run Text="{Binding MainLogPath, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding PerPortLogHint}" Foreground="#666666" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ===== 对拍摘要（默认折叠，只露结论） ===== -->
        <Expander Grid.Row="1" Margin="4" IsExpanded="False" Background="#F7F7F7" BorderBrush="#CCCCCC">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="对拍摘要" FontWeight="Bold"/>
                    <TextBlock Text="{Binding DiffVerdict}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Expander.Header>
            <TextBox Text="{Binding DiffText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                     FontFamily="Consolas" FontSize="11" Height="140" Margin="6"
                     VerticalContentAlignment="Top" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Expander>

        <!-- ===== 打印区：多行虚拟化列表 + 统一时间轴 ===== -->
        <GroupBox Grid.Row="2" Header="统一时间轴（设备文本 + F5 帧，同一主机时钟）" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 过滤条（按端口 / 按域 / 只看帧；「暂停」= 取消自动落底） -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,2">
                    <CheckBox Content="端口 1" IsChecked="{Binding ShowPort1}" VerticalAlignment="Center" Margin="4,2"/>
                    <CheckBox Content="端口 2" IsChecked="{Binding ShowPort2}" VerticalAlignment="Center" Margin="8,2"
                              IsEnabled="{Binding UsePort2}"/>
                    <CheckBox Content="只看 F5 帧" IsChecked="{Binding OnlyFrames}" VerticalAlignment="Center" Margin="8,2"/>
                    <TextBlock Text="域" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <ComboBox MinWidth="120" ItemsSource="{Binding DomainChoices}" SelectedItem="{Binding DomainFilter}"/>
                    <CheckBox Content="自动落底" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" Margin="12,2"
                              ToolTip="取消勾选即暂停滚动，便于回看"/>
                    <TextBlock Text="{Binding Lines.Count, StringFormat='显示 {0} 行'}" VerticalAlignment="Center"
                               Margin="12,0" Foreground="#666666" FontSize="11"/>
                </StackPanel>

                <ListBox x:Name="LogList" Grid.Row="1" Margin="4"
                         ItemsSource="{Binding Lines}"
                         FontFamily="Consolas" FontSize="11"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2,0"/>
                            <Setter Property="Background" Value="{Binding Background}"/>
                            <Setter Property="Foreground" Value="{Binding Foreground}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Time}" Foreground="#999999" Width="86"/>
                                <TextBlock Text="{Binding Port}" FontWeight="SemiBold" Width="92"/>
                                <TextBlock Text="{Binding Domain}" Foreground="#888888" Width="88"/>
                                <TextBlock Text="{Binding Text}" TextWrapping="NoWrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
