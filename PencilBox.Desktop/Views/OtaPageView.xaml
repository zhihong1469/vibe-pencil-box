<UserControl x:Class="PencilBox.Desktop.Views.OtaPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== 升级通道（公司协议 0x16） ========== -->
        <GroupBox Grid.Row="0" Header="升级通道" Margin="4">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="升级对象：" VerticalAlignment="Center"
                               Foreground="#555" MinWidth="68"/>
                    <ComboBox Grid.Column="1" MinWidth="240"
                              ItemsSource="{Binding TargetOptions}"
                              SelectedItem="{Binding SelectedTarget}"
                              DisplayMemberPath="DisplayName"
                              ToolTip="只做前两种：基站（USB 自升级）/ 笔端（串口直连）。第三种（经基站给笔升级，DONTYPE=0x01 透传）待基站侧 relay 就绪后再提供。"/>
                </Grid>

                <TextBlock Margin="74,4,0,0" Foreground="#666" FontSize="11"
                           Text="{Binding SelectedTarget.Description}"/>

                <!-- 串口选择（仅"笔端（串口直连）"通道需要） -->
                <Grid Margin="0,6,0,0" Visibility="{Binding IsSerialTarget, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="笔端串口：" VerticalAlignment="Center"
                               Foreground="#555" MinWidth="68"/>
                    <ComboBox Grid.Column="1" MinWidth="130" Margin="0,0,8,0"
                              ItemsSource="{Binding SerialPorts}"
                              SelectedItem="{Binding SelectedSerialPort}"
                              ToolTip="115200,N,8,1；打开时不施加 DTR/RTS（避免复位笔端）"/>
                    <Button Grid.Column="2" Content="刷新端口" Command="{Binding LoadSerialPortsCommand}"
                            Style="{StaticResource ActionButton}" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#999" FontSize="11"
                               Text="串口直连笔端（变长帧、不补零）"/>
                </Grid>

                <TextBlock Margin="74,6,0,0" Foreground="#666" FontSize="11" TextWrapping="Wrap"
                           Text="说明：升级前请确认已选对通道与固件（选错升级对象会被设备拒绝并回原因码，见下方日志）。第三种“经基站给笔升级”依赖基站侧 relay（S3），本页暂不提供。"/>
            </StackPanel>
        </GroupBox>

        <!-- ========== 设备与固件 ========== -->
        <GroupBox Grid.Row="1" Header="设备与固件" Margin="4">
            <StackPanel>
                <!-- 设备当前版本（0x03）：升级前判断"是否已同版本" / 升级后复核 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="设备版本：" VerticalAlignment="Center"
                               Foreground="#555" MinWidth="68"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#2C3E50"
                               TextWrapping="Wrap" Text="{Binding DeviceVersionText}"/>
                    <Button Grid.Column="2" Content="读设备版本(0x03)" Command="{Binding ReadDeviceVersionCommand}"
                            Style="{StaticResource ActionButton}" IsEnabled="{Binding CanReadDeviceVersion}"
                            ToolTip="按当前通道读 0x03：串口＝笔端 / USB＝基站。升级前用于判断是否已同版本；升级后用于复核版本是否变化"/>
                </Grid>

                <!-- 固件文件 -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="固件文件：" VerticalAlignment="Center"
                               Foreground="#555" MinWidth="68"/>
                    <TextBox Grid.Column="1" Text="{Binding FirmwarePath, Mode=OneWay}"
                             IsReadOnly="True" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="浏览..." Command="{Binding BrowseFirmwareCommand}"
                            Style="{StaticResource ActionButton}"/>
                </Grid>

                <TextBlock Margin="74,4,0,0" Foreground="#666" FontSize="11" TextWrapping="Wrap"
                           Text="{Binding ImageSummary}"/>

                <!-- 目标版本 + HVER -->
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="目标版本：" VerticalAlignment="Center"
                               Foreground="#555" MinWidth="68"/>
                    <TextBox Grid.Column="1" MinWidth="110" Margin="0,0,16,0"
                             Text="{Binding TargetVersion, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="格式 M.m.p。必须等于【该固件自身的版本号】（设备会按它做同版本跳过与最终校验），且与设备当前版本不同 —— 相同则设备回 DCMD=0x02 跳过、不进传输。选文件时会尝试从文件名自动推断。"/>
                    <TextBlock Grid.Column="2" Text="HVER：" VerticalAlignment="Center"
                               Foreground="#555" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="3" Width="70" HorizontalAlignment="Left"
                             Text="{Binding Hver, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="板级序号原值（R1 V1.0 笔端板 = 6；基站轨 = 1）。默认 6；不符设备会回 FF + 原因 01。填 -1 表示按升级对象自动取配置值。"/>
                </Grid>

                <TextBlock Margin="74,6,0,0" Foreground="#B03A2E" FontSize="11" TextWrapping="Wrap"
                           Text="{Binding StageNote}"/>
            </StackPanel>
        </GroupBox>

        <!-- ========== 进度与操作 ========== -->
        <GroupBox Grid.Row="2" Header="进度" Margin="4">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0" Height="22" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                               FontWeight="Bold" Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="开始升级" Command="{Binding StartUpgradeCommand}"
                            Style="{StaticResource ActionButton}" IsEnabled="{Binding CanStart}"/>
                    <Button Content="取消" Command="{Binding CancelUpgradeCommand}"
                            Style="{StaticResource ActionButton}" IsEnabled="{Binding IsUpgrading}"/>
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#2C3E50"
                               Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- ========== 日志 ========== -->
        <GroupBox Grid.Row="3" Header="升级日志" Margin="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="清空日志" Command="{Binding ClearLogCommand}"
                            Style="{StaticResource ToolbarButton}"/>
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#666" FontSize="11"
                               Text="0x16 拉模式：开始 → 设备请求(0x0A) → 22×数据片(0x07) → 进度/终态(0x20)"/>
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}"
                         FontFamily="Consolas" FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingPanel.ScrollUnit="Pixel"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
