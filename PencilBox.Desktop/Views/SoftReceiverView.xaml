<UserControl x:Class="PencilBox.Desktop.Views.SoftReceiverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="800">
    <!-- 软件接收器页（形态③）：PC 直连键盘收语音，绕过硬件基站。
         状态卡 + 连接控制 + 事件流；扩音泵出走引擎外源模式（ExternalSource）。
         布局铁律（坑点速查 §三）：横排用 WrapPanel 防右侧静默裁切，不用横向 StackPanel+禁横滚。 -->
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 状态卡 -->
        <Border Grid.Row="0" Background="#F4F6F7" BorderBrush="#D5DBDB" BorderThickness="1"
                CornerRadius="4" Padding="12" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="连接：" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#7F8C8D"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="#1E8449"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="电量：" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBlock Text="{Binding BatteryText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="充电：" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBlock Text="{Binding ChargeText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="笔端状态：" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBlock Text="{Binding DevStateText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="档位：" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBlock Text="{Binding ModeText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="扩音泵出：" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBlock Text="{Binding SpeakerText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="#0B5345" FontWeight="SemiBold"/>
                        <!-- 8i：解码 PCM 输出目标可选——不选=系统默认扬声器，选了=指定播放设备 -->
                        <ComboBox ItemsSource="{Binding SpeakerOutputOptions}" SelectedItem="{Binding SelectedSpeakerOutput}"
                                  Width="180" Margin="0,0,8,0" VerticalAlignment="Center"
                                  ToolTip="解码 PCM 输出到哪台播放设备：默认=系统默认扬声器；下拉=本机全部活动播放设备（8i 路由可选）"/>
                        <!-- 11-03：软件增益滑条（对数刻度同扩音页），原始人声过轻时上调，运行中即调即生效 -->
                        <TextBlock Text="增益：" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#555"/>
                        <Slider Minimum="0" Maximum="100" Value="{Binding GainSlider}" MinWidth="120" Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                ToolTip="软件增益（对数刻度 1x~24x，同扩音页）：原始人声过轻就上调；&gt;1x 由限制器防破音；扩音开着时拖动即调即生效"/>
                        <TextBlock Text="{Binding GainText}" VerticalAlignment="Center" MinWidth="40" Margin="0,0,8,0"
                                   Foreground="#0B5345" FontWeight="SemiBold"/>
                        <!-- 08 号 M3：独占渲染（WASAPI Exclusive 吃满引擎税；无 AEC/ANS=纯渲染 A/B 腿） -->
                        <CheckBox Content="独占渲染" IsChecked="{Binding IsExclusiveRender, Mode=TwoWay}"
                                  IsEnabled="{Binding CanChangeExclusiveRender}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                  ToolTip="WASAPI 独占模式直出（协商 48k/2ch 优先，失败自动回退共享并显原因）：吃满 Windows 音频引擎税；无 AEC/ANS 处理链=纯渲染延迟 A/B 腿；独占期间本机其他声音被顶掉；扩音开着时不可改（先关再开）"/>
                        <!-- 一键实时扩音（第一性需求：键盘麦人声→PC 扬声器）；链路=解码 PCM→引擎外源泵→扬声器 -->
                        <Button Content="{Binding SpeakerButtonText}" Command="{Binding ToggleSpeakerCommand}"
                                Style="{StaticResource ActionButton}"
                                IsEnabled="{Binding CanToggleSpeaker}"
                                ToolTip="键盘麦克风人声实时扩音（解码 PCM→扩音引擎外源泵→上方所选输出设备；勾选独占渲染=Exclusive 直出）；CLI 等价=srx amp / srx hid --speaker"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                        <TextBlock Text="虚拟麦克风：" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBlock Text="{Binding BridgeDeviceText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="#0B5345" FontWeight="SemiBold"
                                   ToolTip="开桥后第三方软件选此采集端录音即 R1 人声"/>
                        <!-- 8i：桥目标可选——不选=自动配对（非 UU 优先），选了=泵进指定播放设备 -->
                        <ComboBox ItemsSource="{Binding BridgeTargetOptions}" SelectedItem="{Binding SelectedBridgeTarget}"
                                  Width="170" Margin="0,0,8,0" VerticalAlignment="Center"
                                  ToolTip="桥目标=解码 PCM 泵进的播放端：默认=自动配对（非 UU 优先）；手动选定后第三方软件从其同族采集端拿麦克风（8i 路由可选）"/>
                        <Button Content="{Binding BridgeText}" Command="{Binding ToggleBridgeCommand}"
                                Style="{StaticResource ActionButton}"
                                IsEnabled="{Binding CanToggleBridge}"
                                ToolTip="开桥=解码 PCM 泵进上方所选桥目标播放端，第三方软件从其同卡采集端当麦克风录音；需先装 VB-Cable；CLI 等价=srx bridge"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="录制 WAV：" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#555"/>
                        <Button Content="{Binding RecordText}" Command="{Binding ToggleRecordCommand}" Margin="0,0,0,0"
                                Style="{StaticResource ActionButton}"
                                IsEnabled="{Binding CanRecord}"
                                ToolTip="解码 PCM 直落 WAV（16k/16bit/mono，exe 目录 srx_record\）；BLE 直连与 EP4 直送两路通用；语音流须在流（K2/S1）"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="软件键鼠：" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBlock Text="{Binding KeyActionsText}" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="#0B5345" FontWeight="SemiBold"/>
                        <Button Content="{Binding KeyActionsButtonText}" Command="{Binding ToggleKeyActionsCommand}"
                                Style="{StaticResource ActionButton}"
                                IsEnabled="{Binding CanToggleKeyActions}"
                                ToolTip="键盘腿=按 Keymap 出厂表注入：K3/K4=翻页 K5/K6=音量 K2 语音边界=F13/F14 S1 档位=F15/F16；鼠标腿=空鼠槽直注（相对移动/左右键/滚轮）。注入进前台焦点，点哪算哪；断开自动关；CLI 等价=srx receive --actions"/>
                    </StackPanel>
                </WrapPanel>
                <TextBlock Text="{Binding StatsText}" FontSize="11" Foreground="#7F8C8D" Margin="0,4,0,0"
                           TextWrapping="Wrap" ToolTip="会话统计（DATA 帧/解码/CRC/seq 跳/电量/充电）"/>
                <TextBlock Text="{Binding BridgeInfoText}" FontSize="11" Foreground="#7F8C8D" Margin="0,2,0,0"
                           TextWrapping="Wrap" ToolTip="桥运行态（开桥时每秒刷新：环深/泵入/欠载）"/>
            </StackPanel>
        </Border>

        <!-- 连接控制（数据源行=08 号方案 M1：BLE 直连 | USB EP4 HID 直送；键盘行=指挥官 11-02：下拉选设备，扫描/连接分开） -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <!-- 数据源：SelectedIndex 整数绑定（零转换器，GUI 坑册铁律） -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="数据源：" VerticalAlignment="Center" Foreground="#555"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding SourceOptions}"
                          SelectedIndex="{Binding SelectedSourceIndex}"
                          VerticalContentAlignment="Center"
                          ToolTip="BLE 直连=键盘 GATT svr1 收流（现状流程）；USB EP4 HID 直送=基站 mSBC 60B 经 custom HID 64B 定长报告直达 PC（08 号方案，基站须烧 test/hid 固件 DG_AUD_HID_ENABLE=1；键动作/鼠标/电量不经基站转发，此路不可得）"/>
            </Grid>
            <!-- BLE 键盘行（HID 源时整行收起；DataTrigger 直接绑 bool，不涉转换器） -->
            <Grid Margin="0,0,0,8">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHidSource}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="键盘：" VerticalAlignment="Center" Foreground="#555"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding PenOptions}" SelectedItem="{Binding SelectedPen}"
                      VerticalContentAlignment="Center" Margin="0,0,8,0"
                      ToolTip="已知笔端目录（与仪表盘同款：BLE 扫描+串口 0x51 读过都入库；排序：上次使用＞使用过＞出现过，层内在场优先）">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MacDisplayText}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LocalName, TargetNullValue=（无名）}" Margin="8,0,0,0" Foreground="#555"/>
                            <TextBlock Text="{Binding LevelName, StringFormat=[{0}]}" Margin="8,0,0,0" Foreground="#8E44AD"/>
                            <TextBlock Text="在场" Foreground="#1E8449" Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Rssi, StringFormat={}{0} dBm}" Foreground="#1E8449" Margin="4,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="（离线）" Foreground="#95A5A6" Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPresent}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Content="扫描" Command="{Binding ScanDevicesCommand}" Margin="0,0,8,0"
                    Style="{StaticResource ActionButton}" IsEnabled="{Binding CanScan}"
                    ToolTip="扫 5s 笔端广播并入已知目录（与仪表盘同款一份存储）；键盘连着基站时不广播"/>
            <Button Grid.Column="3" Content="连接" Command="{Binding ConnectCommand}" Margin="0,0,8,0"
                    Style="{StaticResource ActionButton}" IsEnabled="{Binding CanConnect}"
                    ToolTip="连接下拉选中的笔端 MAC（先扫描或从历史目录选）"/>
            <Button Grid.Column="4" Content="断开" Command="{Binding DisconnectCommand}"
                    Style="{StaticResource ActionButton}"
                    IsEnabled="{Binding IsConnected}"/>
            </Grid>

            <!-- HID 腿：EP4 选择 + 0x56 路由（BLE 源时整块收起） -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHidSource}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="EP4：" VerticalAlignment="Center" Foreground="#555"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding HidDevices}"
                              SelectedItem="{Binding SelectedHidDevice}"
                              VerticalContentAlignment="Center" Margin="0,0,8,0"
                              ToolTip="基站 EP4 命令通道（UsagePage 0xFF02 无 RID；与仪表盘/device 命令同款枚举识别，只列 ★ 台）">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshHidDevicesCommand}" Margin="0,0,8,0"
                            Style="{StaticResource ActionButton}" IsEnabled="{Binding CanRefreshHidDevices}"
                            ToolTip="枚举基站 EP4 命令通道（0xFF02 无 RID 承载）"/>
                    <Button Grid.Column="3" Content="连接" Command="{Binding HidConnectCommand}" Margin="0,0,8,0"
                            Style="{StaticResource ActionButton}" IsEnabled="{Binding CanHidConnect}"
                            ToolTip="打开选中 EP4 通道（读线程专用 Highest 优先级常驻——内核 HID ring 浅，丢报告第一责任）"/>
                    <Button Grid.Column="4" Content="断开" Command="{Binding HidDisconnectCommand}"
                            Style="{StaticResource ActionButton}" IsEnabled="{Binding CanHidDisconnect}"
                            ToolTip="断开前路由着的先切回 UAC（保免驱常态）；OTA 会话启动也会自动 route=0 兜底"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="路由：" VerticalAlignment="Center" Foreground="#555"/>
                    <Button Grid.Column="1" Content="切入 HID" Command="{Binding RouteHidOnCommand}" Margin="0,0,8,0"
                            Style="{StaticResource ActionButton}" IsEnabled="{Binding CanRouteHidOn}"
                            ToolTip="0x56 route=1：OK 应答经 ReadFile 到达=读线程在消费的活证明（08 号时序门）；之后 mSBC 音频报告开始到达"/>
                    <Button Grid.Column="2" Content="切回 UAC" Command="{Binding RouteHidOffCommand}" Margin="0,0,8,0"
                            Style="{StaticResource ActionButton}" IsEnabled="{Binding CanRouteHidOff}"
                            ToolTip="0x56 route=0：恢复免驱 UAC 常态；E0 看门狗=基站环溢出自动回 UAC（状态列会显示）"/>
                    <TextBlock Grid.Column="3" Text="状态：" VerticalAlignment="Center" Foreground="#555" Margin="8,0,4,0"/>
                    <TextBlock Grid.Column="4" Text="{Binding HidStatusText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- 延迟实测（chirp 回环；复用 SoftReceiverProbe，CLI srx probe 同一份逻辑） -->
        <GroupBox Grid.Row="2" Header="延迟实测（chirp 回环：扬声器播训练列 → 笔端麦拾取 → BLE 回传）" Padding="8" Margin="0,0,0,8">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="时长(秒)：" VerticalAlignment="Center" Foreground="#555"/>
                    <TextBox Width="64" Margin="0,0,8,0" VerticalContentAlignment="Center"
                             Text="{Binding ProbeSecondsInput, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="10~300，默认 30"/>
                    <Button Content="开始延迟实测" Command="{Binding ProbeCommand}" Margin="0,0,8,0"
                            Style="{StaticResource ActionButton}"
                            IsEnabled="{Binding CanProbe}"
                            ToolTip="需先连接；期间按 K2 语音键或拨 S1 扩音档让语音流在流"/>
                </WrapPanel>
                <TextBlock Text="口径：绝对延迟含起点常量偏置（笔端自由跑钟无共享锚），同场形状/PPM 有效、跨场勿比绝对值。"
                           FontSize="11" Foreground="#7F8C8D" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <!-- 结果多行：只读 TextBox 带 wrap+纵向滚，防长 WAV 路径把行高顶爆 -->
                <TextBox Text="{Binding ProbeResultText, Mode=OneWay}" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="11" Margin="0,6,0,0"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         MinHeight="120" MaxHeight="320" VerticalScrollBarVisibility="Auto"
                         Background="#FBFBFB" BorderBrush="#E5E5E5"/>
            </StackPanel>
        </GroupBox>

        <!-- 事件流：MaxHeight 480 压缩占比（指挥官 11-02 反馈：事件流框太大挤占实测结果阅读区） -->
        <GroupBox Grid.Row="3" Header="事件流（键 / 档位 / 状态槽 / 诊断；最新 200 条）" Padding="4">
            <ListBox ItemsSource="{Binding EventLog}" FontFamily="Consolas" FontSize="12"
                     MaxHeight="480"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <!-- 坑点速查 §三：禁横滚必须配 TextWrapping，否则长行右侧静默裁切 -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>
    </Grid>
</UserControl>
