<Window x:Class="PencilBox.Desktop.Views.SoftTriggerEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建连点器" Width="600" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow" ShowInTaskbar="False">
    <!-- 软触发编辑对话框（13 号 v2.1，2026-10-19 指挥官目验二轮反馈：
         表单区弃 WrapPanel 横堆改标签列对齐（名称整行→触发键→模式→优先级→备注 逐行）；
         步骤行弃 WrapPanel 改共享列宽 Grid=表格对齐；
         修饰键下拉空白根因=ValueTuple 反射取不到字段名（见 .xaml.cs ModifierOptions 注释）） -->
    <StackPanel Margin="14">

        <!-- 表单区：标签列 + 值列，行行对齐 -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="触发键:" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <ComboBox x:Name="TriggerModifierBox" Width="100"
                          SelectedValuePath="Value" DisplayMemberPath="Label"
                          ToolTip="修饰组合：要求的键都按着、其余修饰都没按才算命中（防打字误触）"/>
                <ComboBox x:Name="TriggerKeyBox" Width="120" Margin="6,0,0,0"
                          SelectedValuePath="Value" DisplayMemberPath="Label"
                          ToolTip="全键盘池（F13~F16 属笔端工作状态保留，不在列）；普通字母数字键也可触发，注意误触"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="模式:" VerticalAlignment="Center" Margin="0,0,8,6"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <ComboBox x:Name="ModeBox" Width="130" SelectionChanged="OnModeChanged"
                          ToolTip="单次=触发回放一遍；连发=立即回放并周期重复，再按触发键停止">
                    <ComboBoxItem Content="单次"/>
                    <ComboBoxItem Content="连发（再按停）"/>
                </ComboBox>
                <TextBlock Text="连发周期ms:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBox x:Name="RepeatIntervalBox" Width="60" Text="200"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="优先级:" VerticalAlignment="Center" Margin="0,0,8,6"
                       ToolTip="同一触发键命中多条定义时，优先级大者先回放"/>
            <TextBox x:Name="PriorityBox" Grid.Row="3" Grid.Column="1" Width="60"
                     HorizontalAlignment="Left" Margin="0,0,0,6" Text="0"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="备注:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="NoteBox" Grid.Row="4" Grid.Column="1"/>
        </Grid>

        <!-- 步骤编排（顺序=行序；↑↓ 排序；@延时=本步回放前等待；列宽跨行共享=表格对齐） -->
        <GroupBox Header="回放序列（顺序=行序，↑↓✕ 编排；步前延时=本步回放前的等待 ms）"
                  ToolTip="动作键不得与任何启用定义的触发键相同——动态预留全局律会在保存时把关；触发源后的第一步设 200~300ms 可防回放键夹进触发键按压"
                  Margin="0,0,0,10" Padding="8">
            <StackPanel Grid.IsSharedSizeScope="True">
                <ItemsControl x:Name="StepsList" AlternationCount="100" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="ModifierCol"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition SharedSizeGroup="KeyCol"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition SharedSizeGroup="DelayLabelCol"/>
                                    <ColumnDefinition SharedSizeGroup="DelayCol"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition SharedSizeGroup="OpsCol"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding ModifierOptions}"
                                          SelectedValue="{Binding Modifier}"
                                          SelectedValuePath="Value" DisplayMemberPath="Label"
                                          MinWidth="100" VerticalAlignment="Center"
                                          ToolTip="修饰组合：要求的键都按着、其余修饰都没按"/>
                                <ComboBox Grid.Column="2" ItemsSource="{Binding KeyOptions}"
                                          SelectedValue="{Binding Usage}"
                                          SelectedValuePath="Value" DisplayMemberPath="Label"
                                          MinWidth="110" VerticalAlignment="Center"
                                          ToolTip="动作键（F17~F24 也可用——只要没有启用定义把它当触发键，动态预留律会在保存时把关）"/>
                                <TextBlock Grid.Column="4" Text="步前延时ms:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox Grid.Column="5" Text="{Binding DelayMsBefore, TargetNullValue=0}"
                                         Width="56" VerticalAlignment="Center"
                                         ToolTip="本步回放【前】等待的 ms；触发源后的第一步设 200~300ms，可防回放键夹进触发键按压导致目标软件热键判定失效（引擎还会自动等触发键松开再回放，双保险）"/>
                                <StackPanel Grid.Column="7" Orientation="Horizontal">
                                    <Button Content="↑" Click="OnStepUp" Width="24" Height="24" Padding="0"
                                            ToolTip="上移（编排顺序）"/>
                                    <Button Content="↓" Click="OnStepDown" Width="24" Height="24" Padding="0" Margin="2,0,0,0"
                                            ToolTip="下移（编排顺序）"/>
                                    <Button Content="✕" Click="OnStepDelete" Width="24" Height="24" Padding="0" Margin="2,0,0,0"
                                            ToolTip="删除该步"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal">
                    <Button Content="＋ 步骤" Click="OnStepAdd" MinWidth="68" Padding="10,3"/>
                    <TextBlock x:Name="ErrorText" Foreground="#C0392B" VerticalAlignment="Center"
                               Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="430"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保存" Click="OnSave" MinWidth="72" Padding="12,4"/>
            <Button Content="取消" Click="OnCancel" MinWidth="72" Margin="8,0,0,0" Padding="12,4"/>
        </StackPanel>
    </StackPanel>
</Window>
