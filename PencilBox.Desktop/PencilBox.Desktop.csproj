<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PencilBox.Core\PencilBox.Core.csproj" />
    <ProjectReference Include="..\PencilBox.Infrastructure\PencilBox.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- 调试工具开关（研发用；成品外发面向普通人时关闭）
       默认：Debug 开、Release 关；可命令行覆盖：-p:EnableDebugTools=true|false -->
  <PropertyGroup>
    <EnableDebugTools Condition="'$(EnableDebugTools)' == '' and '$(Configuration)' == 'Debug'">true</EnableDebugTools>
    <EnableDebugTools Condition="'$(EnableDebugTools)' == ''">false</EnableDebugTools>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableDebugTools)' == 'true'">
    <DefineConstants>$(DefineConstants);DEBUG_TOOLS</DefineConstants>
  </PropertyGroup>

</Project>
