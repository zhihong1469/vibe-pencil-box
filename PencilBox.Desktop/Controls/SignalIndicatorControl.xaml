<UserControl x:Class="PencilBox.Desktop.Controls.SignalIndicatorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="70" MinHeight="60">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Rectangle x:Name="Bar1" Width="6" Height="8" Margin="2,0" VerticalAlignment="Bottom" Fill="#D0D0D0"/>
            <Rectangle x:Name="Bar2" Width="6" Height="14" Margin="2,0" VerticalAlignment="Bottom" Fill="#D0D0D0"/>
            <Rectangle x:Name="Bar3" Width="6" Height="20" Margin="2,0" VerticalAlignment="Bottom" Fill="#D0D0D0"/>
            <Rectangle x:Name="Bar4" Width="6" Height="26" Margin="2,0" VerticalAlignment="Bottom" Fill="#D0D0D0"/>
            <Rectangle x:Name="Bar5" Width="6" Height="32" Margin="2,0" VerticalAlignment="Bottom" Fill="#D0D0D0"/>
        </StackPanel>
        <TextBlock x:Name="StateText" Text="未连接" FontSize="11" Foreground="#888888"
                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
    </StackPanel>
</UserControl>
